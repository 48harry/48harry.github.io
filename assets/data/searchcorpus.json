---
layout: null
---
{%- comment -%}
  Search index for SimpleJekyllSearch (search.html), which matches a query against every field.
  "desc" (the post's summary) and "tags" (its topics) are there to be matched; "date" and
  "category" (the section) are shown under each result. HTML-escaped because the results
  template inserts them as HTML.
{%- endcomment -%}
[
{%- for post in site.posts -%}
  {%- include post-section.html post=post -%}
  {%- capture search_desc -%}{% include excerpt.html post=post length=200 %}{%- endcapture -%}
  {%- assign search_tags = "" | split: "" -%}
  {%- for tag in post.tags -%}
    {%- unless site.system-tags contains tag -%}{%- assign search_tags = search_tags | push: tag -%}{%- endunless -%}
  {%- endfor %}
  {
    "title": {{ post.title | strip_html | escape | jsonify }},
    "desc": {{ search_desc | escape | jsonify }},
    "tags": {{ search_tags | join: ", " | escape | jsonify }},
    "category": {{ section.name | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "date": {{ post.date | date: "%Y.%m.%d" | jsonify }}
  },
{%- endfor -%}
{%- assign search_pages = "" | split: "" -%}
{%- for page in site.html_pages -%}
  {%- if page.title and page.url != "/404.html" -%}{%- assign search_pages = search_pages | push: page -%}{%- endif -%}
{%- endfor -%}
{%- for page in search_pages %}
  {
    "title": {{ page.title | strip_html | escape | jsonify }},
    "desc": {{ page.subtitle | default: page.share-description | strip_html | escape | jsonify }},
    "tags": "",
    "category": "",
    "url": {{ page.url | relative_url | jsonify }},
    "date": "페이지"
  }{% unless forloop.last %},{% endunless %}
{%- endfor %}
]
